# ─── Firebase Web SDK (client) ───────────────────────────────────────────────
# Console Firebase → Project settings → Your apps → SDK setup (Config).
# Estes são públicos por natureza (vão para o bundle); a segurança é via firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-only) ────────────────────────────────────────
# Console Firebase → Project settings → Service accounts → Generate new private key.
# NUNCA prefixar com NEXT_PUBLIC_. Na Vercel, cole a private key com \n literais.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── TibiaData API ───────────────────────────────────────────────────────────
# User-Agent identificado é exigido pela etiqueta da API (ver tibia-knowledge/11).
TIBIADATA_USER_AGENT=TibiaHub/0.1 (+https://github.com/nadson-dr/tibia-hub)
